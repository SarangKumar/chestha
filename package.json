{
  "name": "vistaar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vistaar/web",
    "build": "node tools/build-backgrounds.mjs && npm run build --workspace @vistaar/web",
    "preview": "npm run preview --workspace @vistaar/web",
    "test": "node --test packages/core/test apps/web/test",
    "build:extension": "npm run build && node tools/build-extension.mjs",
    "extension": "npm run build:extension",
    "watch:extension": "node tools/watch-extension.mjs",
    "pack:extension": "npm run build:extension && node tools/pack-extension.mjs",
    "backgrounds": "node tools/build-backgrounds.mjs",
    "dsa-pack": "node tools/build-dsa-pack.mjs"
  }
}
