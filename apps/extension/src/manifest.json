{
  "manifest_version": 3,
  "name": "Kalpvan",
  "short_name": "Kalpvan",
  "version": "0.1.0",
  "description": "A local-first personal productivity workspace. Opens your tasks, calendar, sounds and DSA practice in one tab.",
  "action": {
    "default_title": "Open Kalpvan",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-mark-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-mark-128.png",
    "192": "icon-192.png",
    "256": "icon-256.png",
    "384": "icon-384.png",
    "512": "icon-512.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "tabs",
    "idle",
    "alarms",
    "storage"
  ],
  "offline_enabled": true
}
