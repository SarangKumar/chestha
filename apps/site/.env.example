# MongoDB connection string. Prisma's MongoDB connector requires a replica set,
# which Atlas provides by default; a plain standalone `mongod` will not work.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/chestha?retryWrites=true&w=majority"

# Signing secret for the session JWT. Generate one with:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=""

# The site's own origin. Needed for absolute URLs in share links and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── OAuth, when you add it ───────────────────────────────────────────────────
# Uncomment the matching provider in apps/site/auth.js as well.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
