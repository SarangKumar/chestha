# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────────
# Every one of these is reproducible from source: `npm run build` for the
# website, `build:extension` for the extension's Vite output, `work` for the
# unpacked extension, `pack:work` for the Web Store archive and its staging copy.
dist/
apps/extension/dist/
release/
*.zip
.vite/
node_modules/.vite/

# ── Generated manifests ──────────────────────────────────────────────────────
# Written by scripts/build-backgrounds.mjs from whatever is in the folder, so the
# checked-in copy would go stale the moment someone adds a file.
apps/extension/public/backgrounds/manifest.json

# ── The author's own media ───────────────────────────────────────────────────
# Wallpaper is personal and licensed to whoever added it, not to the repository.
# The README in that folder explains how to add your own; the app runs with the
# folder empty.
apps/extension/public/backgrounds/*
!apps/extension/public/backgrounds/README.md

# Audio is different: the twelve files below ARE the sound library, declared in
# packages/core/src/sound.js, so a clone without them has a silent app. They are
# tracked by name — anything else dropped in that folder stays personal and
# ignored, which is the licence hazard this section exists for. Adding a sound
# means adding its filename here.
apps/extension/public/audio/*
!apps/extension/public/audio/README.md
!apps/extension/public/audio/catalog.json
!apps/extension/public/audio/light-rain.m4a
!apps/extension/public/audio/flowing-water.m4a
!apps/extension/public/audio/campfire-crackle.m4a
!apps/extension/public/audio/campfire-night-wind.m4a
!apps/extension/public/audio/summer-crickets.m4a
!apps/extension/public/audio/forest-wolves.m4a
!apps/extension/public/audio/street-footsteps.m4a
!apps/extension/public/audio/supermarket-murmur.m4a
!apps/extension/public/audio/church-bell.m4a
!apps/extension/public/audio/road-construction.m4a
!apps/extension/public/audio/horror-ambience.m4a
!apps/extension/public/audio/space-atmosphere.m4a

# ── Local configuration and secrets ──────────────────────────────────────────
*.local
.env
.env.*
!.env.example
# The extension app's per-mode site URL. Public build values, not secrets —
# committed so a fresh clone builds correctly with no setup, and the source has
# no hardcoded origin to fall back to. `.env.local` still overrides them and
# stays ignored.
!apps/extension/.env.development
!apps/extension/.env.production
.npmrc

# ── Editor and tooling state ─────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.eslintcache
*.tsbuildinfo

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Logs and crash reports ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# Next.js (apps/website)
.next/
next-env.d.ts
.vercel/

# Prisma — the client is generated into node_modules by `npm run db:generate`,
# which the root postinstall also runs, so a clone never needs it committed.
packages/db/generated/
